      "scripts": [
        "Latin"
      ],
      "exclude_lines": [
        "\\b(?:roadmap|planned|ideas?|examples?|might|could|consider)\\b"
      ],
      "directives": {
        "review_gate": [
          "(?:\\b(?:risk\\w*|security|money|payment|auth\\w*)\\b[^.\\n]{0,120}\\b(?:require|must|need|before|gate)\\b[^.\\n]{0,120}\\breview\\b|\\b(?:require|must|need|gate)\\b[^.\\n]{0,120}\\breview\\b[^.\\n]{0,120}\\b(?:risk\\w*|security|money|payment|auth\\w*)\\b|reviewer from a different model family reviews)"
        ],
        "handoff": [
          "(?:\\b(?:leave|write|create|keep|update|record|use|require|must)\\b[^.\\n]{0,100}\\bhandoff\\b|\\bhandoff (?:document|record|template|convention)\\b[^.\\n]{0,100}\\b(?:must|should|record|include|contain)\\b)"
        ],
        "friction_line": [
          "\\b(?:end|include|write|record|report|use|must)\\b[^\\n]{0,120}\\b(?:harness )?friction:\\s*"
        ],
        "parallel_worktree": [
          "(?:\\bparallel\\b[^.\\n]{0,100}\\b(?:use|require|must|need)\\b[^.\\n]{0,100}\\bworktrees?\\b|\\b(?:use|require|must|assign)\\b[^.\\n]{0,100}\\bparallel\\b[^.\\n]{0,100}\\bworktrees?\\b)"
        ],
        "plan_approval": [
          "(?:\\b(?:write|record|create|critique|review|need|needs|must|approve|require)\\b[^\\n]{0,100}\\bplan\\b[^\\n]{0,160}\\b(?:approval|approve|before implementation)\\b|\\bplan\\b[^\\n]{0,80}\\b(?:needs|must|requires)\\b[^\\n]{0,100}\\b(?:approval|approve|before implementation)\\b)"
        ]
      },
      "topics": {
        "review_gate": [
          "\\b(?:reviews?|reviewers?)\\b"
        ],
        "handoff": [
          "\\bhand[ -]?offs?\\b"
        ],
        "friction_line": [
          "\\bfriction\\b"
        ],
        "parallel_worktree": [
          "\\bworktrees?\\b"
        ],
        "plan_approval": [
          "\\b(?:approvals?|plans?|planning|specs?|specifications?)\\b"
        ]
      },
      "denials": {
        "review_gate": [
          "(?:\\b(?:reviews?|reviewers?)\\b)\\s+(?:(?:is|are)\\s+)?(?:not\\s+(?:required|needed)|optional|unnecessary)\\b",
          "\\b(?:do\\s+not|never)\\s+(?:require|need)\\s+(?:a\\s+|an\\s+)?(?:\\b(?:reviews?|reviewers?)\\b)",
          "\\bno\\s+(?:\\b(?:reviews?|reviewers?)\\b)\\s+(?:is\\s+)?(?:required|needed)\\b"
        ],
        "handoff": [
          "(?:\\bhand[ -]?offs?\\b)\\s+(?:(?:is|are)\\s+)?(?:not\\s+(?:required|needed)|optional|unnecessary)\\b",
          "\\b(?:do\\s+not|never)\\s+(?:require|need)\\s+(?:a\\s+|an\\s+)?(?:\\bhand[ -]?offs?\\b)",
          "\\bno\\s+(?:\\bhand[ -]?offs?\\b)\\s+(?:is\\s+)?(?:required|needed)\\b"
        ],
        "friction_line": [
          "(?:\\bfriction\\b)\\s+(?:(?:is|are)\\s+)?(?:not\\s+(?:required|needed)|optional|unnecessary)\\b",
          "\\b(?:do\\s+not|never)\\s+(?:require|need)\\s+(?:a\\s+|an\\s+)?(?:\\bfriction\\b)",
          "\\bno\\s+(?:\\bfriction\\b)\\s+(?:is\\s+)?(?:required|needed)\\b"
        ],
        "parallel_worktree": [
          "(?:\\bworktrees?\\b)\\s+(?:(?:is|are)\\s+)?(?:not\\s+(?:required|needed)|optional|unnecessary)\\b",
          "\\b(?:do\\s+not|never)\\s+(?:require|need)\\s+(?:a\\s+|an\\s+)?(?:\\bworktrees?\\b)",
          "\\bno\\s+(?:\\bworktrees?\\b)\\s+(?:is\\s+)?(?:required|needed)\\b"

{
  "version": 1,
  "conventions": [
    "review_gate",
    "handoff",
    "friction_line",
    "parallel_worktree",
    "plan_approval"
  ],
  "languages": {
    "en": {
      "scripts": [
        "Latin"
      ],
      "exclude_lines": [
        "\\b(?:roadmap|planned|ideas?|examples?|might|could|consider)\\b|\\b(?:not|never)\\s+(?:require|use|write|need)",
        "\\b(?:not required|not needed|optional)\\b"
      ],
      "directives": {
        "review_gate": [
          "(?:\\b(?:risk\\w*|security|money|payment|auth\\w*)\\b[^.\\n]{0,120}\\b(?:require|must|need|before|gate)\\b[^.\\n]{0,120}\\breview\\b|\\b(?:require|must|need|gate)\\b[^.\\n]{0,120}\\breview\\b[^.\\n]{0,120}\\b(?:risk\\w*|security|money|payment|auth\\w*)\\b|reviewer from a different model family reviews)"
        ],
        "handoff": [
          "(?:\\b(?:leave|write|create|keep|update|record|use|require|must)\\b[^.\\n]{0,100}\\bhandoff\\b|\\bhandoff (?:document|record|template|convention)\\b[^.\\n]{0,100}\\b(?:must|should|record|include|contain)\\b)"
        ],
        "friction_line": [
          "\\b(?:end|include|write|record|report|use|must)\\b[^\\n]{0,120}\\b(?:harness )?friction:\\s*"
        ],
        "parallel_worktree": [
          "(?:\\bparallel\\b[^.\\n]{0,100}\\b(?:use|require|must|need)\\b[^.\\n]{0,100}\\bworktrees?\\b|\\b(?:use|require|must|assign)\\b[^.\\n]{0,100}\\bparallel\\b[^.\\n]{0,100}\\bworktrees?\\b)"
        ],
        "plan_approval": [
          "(?:\\b(?:write|record|create|critique|review|need|needs|must|approve|require)\\b[^\\n]{0,100}\\bplan\\b[^\\n]{0,160}\\b(?:approval|approve|before implementation)\\b|\\bplan\\b[^\\n]{0,80}\\b(?:needs|must|requires)\\b[^\\n]{0,100}\\b(?:approval|approve|before implementation)\\b)"
        ]
      }
    },
    "ko": {
      "scripts": [
        "Hangul"
      ],
      "exclude_lines": [
        "(?:\\ub85c\\ub4dc\\ub9f5|\\ud5a5\\ud6c4|\\uc608\\uc815|\\uc544\\uc774\\ub514\\uc5b4|\\uc608\\uc2dc|\\uc608\\uc81c|\\uace0\\ub824|\\uac80\\ud1a0\\s*\\uc911)",
        "(?:\\ud544\\uc694|\\ud544\\uc218|\\uc694\\uad6c|\\uc0ac\\uc6a9|\\uc791\\uc131|\\uc2b9\\uc778|\\ub9ac\\ubdf0|\\uc778\\uacc4)[^\\n]{0,40}(?:\\uc5c6|\\uc54a|\\uc544\\ub2c8|\\ubd88\\ud544\\uc694|\\uc0dd\\ub7b5|\\uc120\\ud0dd\\s*\\uc0ac\\ud56d)",
        "(?:\\ubd88\\ud544\\uc694|\\uc120\\ud0dd\\s*\\uc0ac\\ud56d|\\ud558\\uc9c0\\s*\\ub9d0)"
      ],
      "directives": {
        "review_gate": [
          "\\ub2e4\\ub978\\s*(?:\\ubaa8\\ub378\\s*)?\\uacc4\\uc5f4[^\\n]{0,60}(?:\\ub3c5\\ub9bd\\s*)?\\ub9ac\\ubdf0",
          "(?:\\uc704\\ud5d8|\\ubcf4\\uc548|\\ub3c8|\\uacb0\\uc81c|\\uc778\\uc99d)[^\\n]{0,100}(?:\\ub9ac\\ubdf0|\\uac80\\ud1a0)[^\\n]{0,60}(?:\\ud544\\uc218|\\ud544\\uc694|\\uc694\\uad6c|\\ubc1b|\\uac70\\uce5c|\\ud55c\\ub2e4)",
          "(?:\\ub9ac\\ubdf0|\\uac80\\ud1a0)\\s*(?:\\uc218\\uc900|\\ub2e8\\uacc4)[^\\n]{0,80}(?:\\uc801\\uc6a9|\\ub530\\ub978|\\ud544\\uc218|\\uc815\\ud55c)"
        ],
        "handoff": [
          "\\uc778\\uacc4[^\\n]{0,100}(?:\\uc791\\uc131|\\ub0a8\\uae34|\\ub0a8\\uae30|\\uae30\\ub85d|\\uc0ac\\uc6a9|\\ud544\\uc218|\\ud544\\uc694|\\ud55c\\ub2e4)",
          "(?:\\uc791\\uc131|\\uae30\\ub85d|\\uc0ac\\uc6a9)[^\\n]{0,80}\\uc778\\uacc4"
        ],
        "friction_line": [
          "(?:\\ubcf4\\uace0|\\uc791\\uc131|\\uae30\\ub85d|\\ub0a8\\uae34|\\ub0a8\\uae30|\\ub05d|\\ud3ec\\ud568)[^\\n]{0,120}(?:Harness friction:|\\ud558\\ub124\\uc2a4\\s*\\ub9c8\\ucc30\\s*:)",
          "(?:Harness friction:|\\ud558\\ub124\\uc2a4\\s*\\ub9c8\\ucc30\\s*:)[^\\n]{0,120}(?:\\uc791\\uc131|\\uae30\\ub85d|\\ub0a8\\uae34|\\ub0a8\\uae30|\\ud3ec\\ud568|\\ub05d\\ub0b8)"
        ],
        "parallel_worktree": [
          "(?:\\uc6cc\\ud06c\\ud2b8\\ub9ac|worktrees?)[^\\n]{0,100}(?:\\uc0ac\\uc6a9|\\ubd84\\ub9ac|\\ud544\\uc218|\\ud544\\uc694|\\ub9cc\\ub4e0|\\ub9cc\\ub4e4|\\uc791\\uc5c5\\ud55c)",
          "(?:\\ubcd1\\ub82c|\\ubd84\\ub9ac|\\ubcc4\\ub3c4)[^\\n]{0,80}(?:\\uc6cc\\ud06c\\ud2b8\\ub9ac|worktrees?)"
        ],
        "plan_approval": [
          "(?:\\uacc4\\ud68d|\\uad6c\\ud604|\\uc791\\uc5c5)[^\\n]{0,100}(?:\\ub300\\ud45c|\\uc18c\\uc720\\uc790)?\\s*\\uc2b9\\uc778[^\\n]{0,80}(?:\\ubc1b|\\ud544\\uc218|\\ud544\\uc694|\\ud6c4|\\uc804|\\uc694\\uad6c)",
          "\\ub300\\ud45c\\s*\\uc2b9\\uc778(?:\\uc740|\\uc744|\\uc774)?\\s*(?:\\ud544\\uc218|\\ud544\\uc694|\\ubc1b|\\uc720\\uc9c0|\\uadf8\\ub300\\ub85c)"
        ]
      }
    }
  }
}

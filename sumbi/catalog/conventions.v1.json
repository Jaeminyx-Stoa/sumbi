          "(?:\\b(?:approvals?|plans?|planning|specs?|specifications?)\\b)\\s+(?:(?:is|are)\\s+)?(?:not\\s+(?:required|needed)|optional|unnecessary)\\b",
          "\\b(?:do\\s+not|never)\\s+(?:require|need)\\s+(?:a\\s+|an\\s+)?(?:\\b(?:approvals?|plans?|planning|specs?|specifications?)\\b)",
          "\\bno\\s+(?:\\b(?:approvals?|plans?|planning|specs?|specifications?)\\b)\\s+(?:is\\s+)?(?:required|needed)\\b"
        ]
      }
